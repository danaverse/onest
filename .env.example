# Chronik endpoint (comma separated if multiple)
CHRONIK_URLS=https://chronik.e.cash,https://xec.paybutton.org

# PAW Token ID (hex) once created
TOKEN_ID=
VITE_PAW_TOKEN_ID=
VITE_PRAYER_TOKEN_ID=
VITE_PAW_TICKER=PAW
DEPLOYMENT_JSON=deployments/mainnet-paw.json

# WLotus Genesis & Issuance Alignment (default: live WLotus 1788215242, 108 atoms)
# PAW_GENESIS_UNIX=1788215242
# PAW_MINT_ATOMS=108

# Mint API & Genesis configuration
MINT_API_PORT=8787
MINT_MNEMONIC=
GENESIS_MNEMONIC=
# Test desk seed (Cursor/GitHub secret TEST_DESK_SEEDS) — used to create tPAW
# TEST_DESK_SEEDS=
MINT_SERVING_TIP_INDEX=0
MINT_SERVING_TIP_COUNT=1

# Server-enforced soft wait between challenge issue and burn (seconds, 0 disables)
MINT_MIN_PRAY_SECONDS=54
# Sponsored first pet profile (6-atom burn) and sponsored post (1-atom burn)
MINT_PROFILE_MIN_PRAY_SECONDS=120
MINT_POST_MIN_PRAY_SECONDS=60

# PAW atoms the user's wallet pays the desk on user-paid burns (listing fee)
MINT_LISTING_FEE_ATOMS=6

# Flat XEC fee for desk-built actions: profiles (burn 1 + retain 6) and posts (burn 1)
# MINT_PROFILE_XEC_FEE=20
# MINT_ACTION_XEC_FEE=20   # overrides the fee for profiles and posts
# MINT_VOTE_XEC_FEE=6      # flat fee for XEC-paid votes (1 PAW burn, no listing)
# MINT_PAID_PROFILE_STORE=data/paid-profiles.json

# DANA Index configuration
DANA_INDEX_PORT=8788
DANA_INDEX_STORE=data/dana-index-burns.json
PUBLIC_SITE_ORIGIN=https://onest.pet

# Social store (SQLite + hash-keyed media on local disk; swap for R2 later)
ONEST_SOCIAL_DB=data/onest-social.sqlite
ONEST_MEDIA_DIR=data/media
ONEST_MAX_POSTS_PER_DAY=10
ONEST_MAX_COMMENTS_PER_DAY=50
ONEST_MAX_UPLOADS_PER_DAY=40
ONEST_MAX_WRITES_PER_IP_PER_MIN=60
