{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "../../src/offering/animalProfileFields.ts",
    "../../src/offering/danaMemorial.ts",
    "../../src/offering/memorialFromScript.ts",
    "../../src/explorer.ts",
    "../../src/lib/trendingScore.ts"
  ],
  "exclude": ["src/sw.ts"]
}
